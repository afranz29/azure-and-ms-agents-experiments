# Azure AI Foundry project endpoint (used for RedTeam orchestration/scoring,
# and as the base for reaching the Agent itself)
# Found in: Azure AI Foundry portal -> your project -> Overview -> Project details
AZURE_PROJECT_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project

# Name of the Agent under test
# Found in: Azure AI Foundry portal -> your project -> Build -> Agents -> your agent
AZURE_AGENT_NAME=your-agent-name

# Azure OpenAI endpoint + deployment used as the LLM judge for manual_scan.py
AZURE_OPENAI_ENDPOINT=https://your-account.openai.azure.com/openai/v1
AZURE_MODEL=your-model-deployment-name
