# Azure AI Foundry project endpoint (used for RedTeam orchestration/scoring, not the target call)
# Found in: Azure AI Foundry portal → your project → Overview → Project details
AZURE_PROJECT_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project

# Azure OpenAI endpoint for the actual model deployment under test (foundry_target)
# Found in: Azure AI Foundry portal → your project → Models + endpoints → deployment → endpoint URL
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1

# Deployment name of the model used by foundry_target
# Defaults to gpt-4o if unset
AZURE_MODEL=gpt-4o

# Optional: API key auth (skip if using `az login` / DefaultAzureCredential)
AZURE_API_KEY=
